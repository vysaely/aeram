# Maintainer: AERAM Maintainers <https://github.com/vysaely/aeram>
pkgname=aeram
pkgver=0.1.0
pkgrel=1
pkgdesc="Lightweight Roblox Account Manager for Linux with Mocktail integration"
arch=('x86_64')
url="https://github.com/vysaely/aeram"
license=('GPL-3.0-or-later')
depends=(
    'python>=3.10'
    'python-pyqt6>=6.4.0'
    'python-pyqt6-webengine>=6.4.0'
    'python-pynacl>=1.5.0'
    'python-evdev>=1.6.0'
)
optdepends=(
    'mocktail-bin: native Linux Roblox runtime for multi-instance launching'
    'python-dbus: KWin Wayland scripting integration for KDE Plasma'
    'hyprland: Wayland compositor support via hyprctl window focus IPC'
    'xdotool: active window focus cycling for X11 sessions'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-wheel'
    'python-setuptools'
    'gcc'
    'make'
    'git'
)
source=(
    "git+https://github.com/vysaely/aeram.git#branch=main"
    "aeram.desktop"
)
sha256sums=('SKIP'
            'SKIP')

build() {
    cd "$srcdir/$pkgname"
    make -C native
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$pkgname"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # Install native mouse companion helper library
    install -Dm755 native/libmocktail_mouse_helper.so "$pkgdir/usr/lib/aeram/libmocktail_mouse_helper.so"

    # Install application icons (scalable vector and 512x512 raster)
    if [ -f assets/aeram.svg ]; then
        install -Dm644 assets/aeram.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/aeram.svg"
    else
        install -Dm644 assets/roblox-account-manager.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/aeram.svg"
    fi
    if [ -f assets/aeram.png ]; then
        install -Dm644 assets/aeram.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/aeram.png"
    fi

    # Install desktop application launcher
    install -Dm644 "$srcdir/aeram.desktop" "$pkgdir/usr/share/applications/aeram.desktop"

    # Install MIT License
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
