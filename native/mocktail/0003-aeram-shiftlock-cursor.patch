+TEST_F(AssetManagerTest, ShiftLockCursorOverrideReplacesRobloxTexture) {
+  AAssetManager* mgr = AAssetManager_fromJava(nullptr, nullptr);
+  ASSERT_NE(mgr, nullptr);
+  const std::string image = MakeTempRoot() + "/shiftlock.png";
+  const std::string bytes = "\x89PNG custom shift lock";
+  std::ofstream(image, std::ios::binary) << bytes;
+
+  ASSERT_EQ(setenv("MOCKTAIL_SHIFTLOCK_CURSOR", image.c_str(), 1), 0);
+  for (const char* name : {"content/textures/MouseLockedCursor.png",
+                           "rbxasset://textures/MouseLockedCursor.png"}) {
+    AAsset* asset = AAssetManager_open(mgr, name, 0);
+    ASSERT_NE(asset, nullptr) << name;
+    ASSERT_EQ(AAsset_getLength(asset), static_cast<off_t>(bytes.size()));
+    EXPECT_EQ(std::memcmp(AAsset_getBuffer(asset), bytes.data(), bytes.size()),
+              0);
+    AAsset_close(asset);
+  }
+  // Other textures are untouched, and an unreadable override falls back to
+  // the payload (which has no such file in this root).
+  EXPECT_EQ(AAssetManager_open(mgr, "content/textures/ArrowCursor.png", 0),
+            nullptr);
+  ASSERT_EQ(setenv("MOCKTAIL_SHIFTLOCK_CURSOR", "/nonexistent/x.png", 1), 0);
+  EXPECT_EQ(AAssetManager_open(mgr, "content/textures/MouseLockedCursor.png", 0),
+            nullptr);
+  ASSERT_EQ(unsetenv("MOCKTAIL_SHIFTLOCK_CURSOR"), 0);
+}
