+// MOCKTAIL_SHIFTLOCK_CURSOR names a PNG served for Roblox's shift-lock icon.
+// Requests are answered before the payload lookup, so the image also applies
+// to Roblox versions that no longer ship the texture and download it instead.
+constexpr std::string_view kShiftLockCursorTexture =
+    "textures/MouseLockedCursor.png";
+
+bool LoadShiftLockCursorOverride(std::string_view requested, AAsset* asset) {
+  const char* override_path = GetEnvNonEmpty("MOCKTAIL_SHIFTLOCK_CURSOR");
+  if (override_path == nullptr || requested != kShiftLockCursorTexture) {
+    return false;
+  }
+  if (!LoadFile(override_path, &asset->data) || asset->data.empty()) {
+    std::fprintf(stderr,
+                 "  [asset] shift-lock cursor %s unreadable; using Roblox's\n",
+                 override_path);
+    asset->data.clear();
+    return false;
+  }
+  asset->path = override_path;
+  std::fprintf(stderr, "  [asset] shift-lock cursor: %s\n", override_path);
+  return true;
+}
