+
+// True when a "mov eax, [rip + disp32]" of the flag value precedes the clamp.
+bool ClampReadsValue(const unsigned char* clamp, uintptr_t value) {
+  for (std::size_t back = 6; back <= 40; ++back) {
+    const unsigned char* load = clamp - back;
+    if (load[0] == 0x8b && load[1] == 0x05 &&
+        reinterpret_cast<uintptr_t>(load) + 6 + ReadDisplacement(load + 2) ==
+            value) {
+      return true;
+    }
+  }
+  return false;
