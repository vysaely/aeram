+
+int32_t ReadDisplacement(const unsigned char* at) {
+  int32_t value = 0;
+  std::memcpy(&value, at, sizeof(value));
+  return value;
+}
+
+// lea r64, [rip + disp32] / mov [rip + disp32], r64 with a REX.W prefix.
+bool IsRipLea(const unsigned char* at) {
+  return (at[0] == 0x48 || at[0] == 0x4c) && at[1] == 0x8d &&
+         (at[2] & 0xc7) == 0x05;
+}
+
+bool IsRipStoreOfSameRegister(const unsigned char* at,
+                              const unsigned char* lea) {
+  return at[0] == lea[0] && at[1] == 0x89 && (at[2] & 0xc7) == 0x05 &&
+         ((at[2] >> 3) & 7) == ((lea[2] >> 3) & 7);
+}
+
+uintptr_t FindTaskSchedulerTargetFpsValue(
+    const std::vector<LibRobloxMapping>& mappings) {
+  static constexpr char kName[] = "\0TaskSchedulerTargetFps";
+  uintptr_t name = 0;
+  for (const LibRobloxMapping& mapping : mappings) {
+    const void* found = memmem(mapping.begin, mapping.length, kName,
+                               sizeof(kName));  // includes the trailing NUL
+    if (found != nullptr) {
+      name = reinterpret_cast<uintptr_t>(found) + 1;
+      break;
+    }
+  }
+  if (name == 0) {
+    return 0;
+  }
+  for (const LibRobloxMapping& mapping : mappings) {
+    if (!mapping.executable || mapping.length < 64) {
