+#ifndef MOCKTAIL_LIBC_SHIM_HOST_CURSOR_TEXTURES_H_
+#define MOCKTAIL_LIBC_SHIM_HOST_CURSOR_TEXTURES_H_
+
+#include <string_view>
+
+namespace libc_shim {
+
+// 64x64 fully transparent 8-bit gray+alpha PNG, the same format as Roblox's
+// own cursor textures. MOCKTAIL_HOST_CURSOR serves it in place of Roblox's
+// software arrow so only the desktop's hardware cursor is visible.
+inline constexpr unsigned char kTransparentCursorPng[] = {
+    0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d,
+    0x49, 0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x40, 0x00, 0x00, 0x00, 0x40,
+    0x08, 0x04, 0x00, 0x00, 0x00, 0x00, 0x60, 0xb9, 0x55, 0x00, 0x00, 0x00,
+    0x1e, 0x49, 0x44, 0x41, 0x54, 0x78, 0xda, 0xed, 0xc1, 0x01, 0x01, 0x00,
+    0x00, 0x00, 0x82, 0x20, 0xff, 0xaf, 0x6e, 0x48, 0x40, 0x01, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0xef, 0x06, 0x20, 0x40, 0x00, 0x01, 0x98,
+    0x01, 0xbe, 0xfd, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae,
+    0x42, 0x60, 0x82};
+
+// Arrow textures relative to the content root.
+inline constexpr const char* kHostCursorArrowTextures[] = {
+    "textures/Cursors/KeyboardMouse/ArrowFarCursor.png",
+    "textures/Cursors/KeyboardMouse/ArrowCursor.png",
+    // Legacy default mouse icon still referenced by the Android client.
+    "textures/ArrowFarCursor.png",
+    "textures/ArrowCursor.png",
+};
+
+inline bool IsHostCursorArrowTexture(std::string_view content_relative) {
+  for (const char* texture : kHostCursorArrowTextures) {
+    if (content_relative == texture) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace libc_shim
+
+#endif  // MOCKTAIL_LIBC_SHIM_HOST_CURSOR_TEXTURES_H_
