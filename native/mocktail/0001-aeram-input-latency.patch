+SdlPointerCaptureBackend::~SdlPointerCaptureBackend() {
+  if (cursor_ != nullptr) {
+    SDL_DestroyCursor(static_cast<SDL_Cursor*>(cursor_));
+  }
+}
+
+bool SdlPointerCaptureBackend::SetCursorImage(const char* png_path, int hot_x,
+                                              int hot_y) {
+  if (png_path == nullptr || png_path[0] == '\0') {
+    return false;
+  }
+  SDL_Surface* surface = SDL_LoadPNG(png_path);
+  if (surface == nullptr) {
+    std::fprintf(stderr, "  [input] host cursor image %s unavailable: %s\n",
+                 png_path, SDL_GetError());
+    return false;
+  }
+  SDL_Cursor* cursor = SDL_CreateColorCursor(surface, hot_x, hot_y);
+  SDL_DestroySurface(surface);
+  if (cursor == nullptr) {
+    std::fprintf(stderr, "  [input] host cursor creation failed: %s\n",
+                 SDL_GetError());
+    return false;
+  }
+  if (!SDL_SetCursor(cursor)) {
+    SDL_DestroyCursor(cursor);
+    return false;
+  }
+  if (cursor_ != nullptr) {
+    SDL_DestroyCursor(static_cast<SDL_Cursor*>(cursor_));
+  }
+  cursor_ = cursor;
+  return true;
+}
+
 }  // namespace window
 }  // namespace mocktail
