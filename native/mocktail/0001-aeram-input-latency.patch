+// The Android payload clamps DFIntTaskSchedulerTargetFps and the render
+// scheduler to 240 even though the desktop client honours higher Basic
+// Settings caps. Raise those immediates before JNI_OnLoad so a configured
+// frame_rate_limit above 240 actually applies. MOCKTAIL_KEEP_ROBLOX_FPS_CLAMP
+// restores the payload's behaviour.
+static void RaiseLibRobloxFrameRateClamps() {
+  if (IsEnabled("MOCKTAIL_KEEP_ROBLOX_FPS_CLAMP")) {
+    return;
+  }
+  // mov ecx, 240; cmp eax, ecx; cmovl ecx, eax  (signed min)
+  static constexpr unsigned char kSignedMin[] = {0xb9, 0xf0, 0x00, 0x00, 0x00,
+                                                 0x39, 0xc8, 0x0f, 0x4c, 0xc8};
+  // mov ecx, 240; cmp eax, ecx; cmovae eax, ecx  (unsigned min)
+  static constexpr unsigned char kUnsignedMin[] = {0xb9, 0xf0, 0x00, 0x00, 0x00,
+                                                   0x39, 0xc8, 0x0f, 0x43, 0xc1};
+  static_assert(sizeof(kSignedMin) == sizeof(kUnsignedMin));
+  constexpr uint32_t kRaisedLimit = 10000;
+  const long page_size_value = sysconf(_SC_PAGESIZE);
+  const uintptr_t page_size =
+      page_size_value > 0 ? static_cast<uintptr_t>(page_size_value) : 4096;
+
+  FILE* maps = std::fopen("/proc/self/maps", "r");
+  if (maps == nullptr) {
+    return;
+  }
+  int patched = 0;
+  char line[1024];
+  while (std::fgets(line, sizeof(line), maps) != nullptr) {
+    if (std::strstr(line, "libroblox.so") == nullptr) {
+      continue;
+    }
+    uintptr_t start = 0;
+    uintptr_t end = 0;
+    char perms[8] = {};
+    if (std::sscanf(line, "%lx-%lx %7s", &start, &end, perms) != 3 ||
+        perms[0] != 'r' || perms[2] != 'x' || end <= start) {
+      continue;
+    }
+    auto* const begin = reinterpret_cast<unsigned char*>(start);
+    const size_t length = end - start;
+    for (size_t i = 0; i + sizeof(kSignedMin) <= length; ++i) {
+      if (begin[i] != 0xb9 ||
+          (std::memcmp(begin + i, kSignedMin, sizeof(kSignedMin)) != 0 &&
+           std::memcmp(begin + i, kUnsignedMin, sizeof(kUnsignedMin)) != 0)) {
+        continue;
+      }
+      const uintptr_t page = reinterpret_cast<uintptr_t>(begin + i) &
+                             ~(page_size - 1);
+      const uintptr_t page_end =
+          (reinterpret_cast<uintptr_t>(begin + i + 5) + page_size - 1) &
+          ~(page_size - 1);
+      void* const page_ptr = reinterpret_cast<void*>(page);
+      if (mprotect(page_ptr, page_end - page,
+                   PROT_READ | PROT_WRITE | PROT_EXEC) != 0) {
+        continue;
+      }
+      std::memcpy(begin + i + 1, &kRaisedLimit, sizeof(kRaisedLimit));
+      mprotect(page_ptr, page_end - page, PROT_READ | PROT_EXEC);
+      ++patched;
+    }
+  }
+  std::fclose(maps);
+  std::cout << "  [runtime] libroblox 240 FPS clamps raised: " << patched
+            << '\n'
+            << std::flush;
+}
