+std::atomic<bool> g_host_cursor_trace{false};
+std::atomic<int> g_host_cursor_trace_budget{32};
+
+// Logs which cursor textures Roblox actually opens, so a missed path shows up
+// in the session log instead of as a second arrow on screen.
+void TraceHostCursorTexture(const std::string& path, const std::string& host) {
+  if (!g_host_cursor_trace.load(std::memory_order_relaxed) ||
+      path.find("Cursor") == std::string::npos ||
+      g_host_cursor_trace_budget.fetch_sub(1, std::memory_order_relaxed) <=
+          0) {
+    return;
+  }
+  std::fprintf(stderr, "  [libc_shim] host cursor: %s %s\n",
+               host != path ? "blanked" : "opened", path.c_str());
+}
+
+bool WriteTransparentCursorPng(const std::string& path) {
+  FILE* file = std::fopen(path.c_str(), "wb");
+  if (file == nullptr) {
+    return false;
+  }
+  const bool written = std::fwrite(kTransparentCursorPng, 1,
+                                   sizeof(kTransparentCursorPng),
+                                   file) == sizeof(kTransparentCursorPng);
+  return std::fclose(file) == 0 && written;
+}
+
+// MOCKTAIL_HOST_CURSOR hides Roblox's software-rendered arrow so the window
+// layer can show the desktop's hardware cursor instead, which the compositor
+// moves at scanout without waiting for a rendered game frame.
+bool ConfigureHostCursorTextureMappings(const std::string& data_root,
+                                        const std::string& content_root) {
+  if (!IsEnabled("MOCKTAIL_HOST_CURSOR") || content_root.empty()) {
+    return false;
+  }
+  EnsureDirectory(data_root);
+  const std::string blank = data_root + "/mocktail_host_cursor_blank.png";
+  if (!WriteTransparentCursorPng(blank)) {
+    std::cerr << "  [libc_shim] host cursor disabled: cannot write " << blank
+              << '\n';
+    return false;
+  }
+  for (const char* texture : kHostCursorArrowTextures) {
+    RegisterPathMapping(content_root + "/" + texture, blank);
+    RegisterPathMapping(std::string("content/") + texture, blank);
+    RegisterPathMapping(std::string("rbx_bin/assets/content/") + texture,
+                        blank);
+  }
+  g_host_cursor_trace.store(true, std::memory_order_relaxed);
+  std::cout << "  [libc_shim] host cursor: Roblox arrow textures hidden\n";
+  return true;
+}
