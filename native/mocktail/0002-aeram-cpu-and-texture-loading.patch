+#ifndef MOCKTAIL_RUNTIME_ENGINE_POLL_REST_H_
+#define MOCKTAIL_RUNTIME_ENGINE_POLL_REST_H_
+
+#include <cstdint>
+
+namespace mocktail {
+namespace runtime {
+
+// With unthrottled presentation the host main thread polls the engine's
+// main-thread message queue back to back. Most polls find nothing and return
+// in a few microseconds, so the loop burns a whole core per instance. Between
+// empty polls the thread may rest briefly instead; a message posted during the
+// rest waits at most kEngineEmptyPollRestNs plus wake-up latency.
+inline constexpr uint64_t kEngineEmptyPollRestNs = 100'000;
+// A poll shorter than this did no engine work.
+inline constexpr uint64_t kEngineEmptyPollMaxNs = 20'000;
+
+enum class EnginePollRest { kSleep, kSpin };
+
+// MOCKTAIL_ENGINE_PUMP_REST: "sleep", "spin" or "auto" (default). Auto sleeps
+// only under the performance governor (as GameMode sets it): under a
+// power-saving governor a core that keeps sleeping is clocked down, which also
+// slows the render thread sharing its frequency domain.
+EnginePollRest ChooseEnginePollRest(const char* setting,
+                                    bool performance_governor);
+const char* EnginePollRestName(EnginePollRest rest);
+
+// The policy for this process, read once.
+EnginePollRest ActiveEnginePollRest();
+
+// Rests after a poll that took poll_ns and returns the time slept. Polls that
+// did work, and the spin policy, never rest.
+uint64_t RestAfterEnginePoll(uint64_t poll_ns);
+
+}  // namespace runtime
+}  // namespace mocktail
+
+#endif  // MOCKTAIL_RUNTIME_ENGINE_POLL_REST_H_
