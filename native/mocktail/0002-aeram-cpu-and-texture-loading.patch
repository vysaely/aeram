new file mode 100644
index 0000000..5b9bbc6
--- /dev/null
+++ b/src/runtime/engine_poll_rest.cc
@@ -0,0 +1,63 @@
+#include "runtime/engine_poll_rest.h"
+
+#include <sys/prctl.h>
+#include <time.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace mocktail {
+namespace runtime {
+namespace {
+
+bool CpuGovernorIsPerformance() {
+  std::FILE* file =
+      std::fopen("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor", "r");
+  if (file == nullptr) {
+    return false;
+  }
+  char governor[32] = {};
+  const bool read = std::fgets(governor, sizeof(governor), file) != nullptr;
+  std::fclose(file);
+  return read && std::strncmp(governor, "performance", 11) == 0;
+}
+
+}  // namespace
+
+EnginePollRest ChooseEnginePollRest(const char* setting,
+                                    bool performance_governor) {
+  if (setting != nullptr && std::strcmp(setting, "sleep") == 0) {
+    return EnginePollRest::kSleep;
+  }
+  if (setting != nullptr && std::strcmp(setting, "spin") == 0) {
+    return EnginePollRest::kSpin;
+  }
+  return performance_governor ? EnginePollRest::kSleep : EnginePollRest::kSpin;
+}
+
+const char* EnginePollRestName(EnginePollRest rest) {
+  return rest == EnginePollRest::kSleep ? "sleep" : "spin";
+}
+
+EnginePollRest ActiveEnginePollRest() {
+  static const EnginePollRest rest = ChooseEnginePollRest(
+      std::getenv("MOCKTAIL_ENGINE_PUMP_REST"), CpuGovernorIsPerformance());
+  return rest;
+}
+
+uint64_t RestAfterEnginePoll(uint64_t poll_ns) {
+  if (poll_ns > kEngineEmptyPollMaxNs ||
+      ActiveEnginePollRest() == EnginePollRest::kSpin) {
+    return 0;
+  }
+  // The default 50 us timer slack would stretch every 100 us rest by half.
+  static const bool slack_lowered = prctl(PR_SET_TIMERSLACK, 1000UL) == 0;
+  (void)slack_lowered;
+  timespec rest{0, static_cast<long>(kEngineEmptyPollRestNs)};
+  clock_nanosleep(CLOCK_MONOTONIC, 0, &rest, nullptr);
+  return kEngineEmptyPollRestNs;
+}
+
+}  // namespace runtime
+}  // namespace mocktail
