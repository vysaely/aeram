+// Enough upscaled texels in one submit to emit on the worker pool; every
+// image must still match the single-threaded decode and resample.
+TEST_P(VulkanEtc2Test, ParallelEmitMatchesSequentialOutput) {
+  Start(true, "4");
+  constexpr std::uint32_t kSize = 64;  // kSmallTextureMaxExtent: upscaled 4x
+  constexpr std::size_t kBytes = (kSize / 4) * (kSize / 4) * 16;
+  constexpr int kImages = 6;
+  std::vector<VkCommandBuffer> commands;
+  std::vector<std::vector<std::uint8_t>> expected;
+  for (int index = 0; index < kImages; ++index) {
+    auto source = CreateSource(kBytes);
+    for (std::size_t byte = 0; byte < kBytes; ++byte) {
+      source.data[byte] = static_cast<std::uint8_t>(byte * 31 + index * 7);
+    }
+    const auto image = CreateImage(kSize, kSize);
+    const auto command = Handle<VkCommandBuffer>(200 + index);
+    Record(command, source, image, kSize, kSize);
+    const auto decoded = Decode(source.data, kSize, kSize);
+    std::vector<std::uint8_t> scaled(kSize * 4 * kSize * 4 * 4);
+    ResampleRgba(decoded.data(), kSize, kSize, kSize * 4, kSize * 4,
+                 scaled.data());
+    expected.push_back(std::move(scaled));
+    commands.push_back(command);
+  }
+  emulation->PrepareSubmit(commands.data(),
+                           static_cast<std::uint32_t>(commands.size()));
+  for (int index = 0; index < kImages; ++index) {
+    EXPECT_EQ(Output(commands[index]), expected[index]) << "image " << index;
+  }
+}
