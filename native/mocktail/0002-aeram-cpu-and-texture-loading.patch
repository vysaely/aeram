+// versus 10 GB/s and 0.9 GB/s with SSE4.1 streaming loads, which cost
+// nothing extra on cached memory.
+#if defined(__x86_64__)
+__attribute__((target("sse4.1"))) void StreamingCopy(std::uint8_t* destination,
+                                                     const std::uint8_t* source,
+                                                     std::size_t bytes) {
+  const std::size_t misalignment =
+      reinterpret_cast<std::uintptr_t>(source) & 15U;
+  if (misalignment != 0) {
+    const std::size_t head = std::min(bytes, 16 - misalignment);
+    std::memcpy(destination, source, head);
+    destination += head;
+    source += head;
+    bytes -= head;
+  }
+  auto* from = reinterpret_cast<__m128i*>(const_cast<std::uint8_t*>(source));
+  auto* to = reinterpret_cast<__m128i*>(destination);
+  for (; bytes >= 64; bytes -= 64, from += 4, to += 4) {
