+TEST_F(JniVmTest, CookieGettersIncludeBrowserTrackerIdentity) {
+  // Installing a provider drops the process-wide cookie cache.
+  const std::string reset;
+  vm_->SetRobloxCredentialProvider(&reset, &TestCredentialProvider);
+  vm_->ClearRobloxCredentialProvider();
+  setenv("MOCKTAIL_ROBLOX_COOKIES",
+         ".ROBLOSECURITY=test-cookie-value\n"
+         "RBXEventTrackerV2=CreateDate=10/18/2026 5:26:22 PM&rbxid=&browserid=707",
+         1);
+  JNIEnv *env = vm_->GetJNIEnv();
+  jclass manager =
+      env->FindClass("com/roblox/universalapp/cookie/JNICookieManager");
+  jmethodID get_cookie = env->GetStaticMethodID(
+      manager, "getCookie", "(Ljava/lang/String;)Ljava/lang/String;");
+  ASSERT_NE(get_cookie, nullptr);
+  auto header = static_cast<jstring>(env->CallStaticObjectMethod(
+      manager, get_cookie, env->NewStringUTF("roblox.com")));
+  EXPECT_EQ(ReadJavaString(env, header),
+            ".ROBLOSECURITY=test-cookie-value; RBXEventTrackerV2="
+            "CreateDate=10/18/2026 5:26:22 PM&rbxid=&browserid=707");
+
+  jclass settings =
+      env->FindClass("com/roblox/engine/jni/NativeSettingsInterface");
+  jmethodID netscape =
+      env->GetStaticMethodID(settings, "nativeGetCookiesInNetscapeFormat",
+                             "(Ljava/lang/String;)Ljava/lang/String;");
+  ASSERT_NE(netscape, nullptr);
+  auto jar = static_cast<jstring>(env->CallStaticObjectMethod(
+      settings, netscape, env->NewStringUTF("https://apis.roblox.com/")));
+  EXPECT_EQ(ReadJavaString(env, jar),
+            ".apis.roblox.com\tTRUE\t/\tTRUE\t2147483647\t.ROBLOSECURITY\t"
+            "test-cookie-value\n"
+            ".apis.roblox.com\tTRUE\t/\tFALSE\t2147483647\tRBXEventTrackerV2\t"
+            "CreateDate=10/18/2026 5:26:22 PM&rbxid=&browserid=707");
+}
+
