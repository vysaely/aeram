+// The typed credential carries only .ROBLOSECURITY, but the Android app's
+// CookieManager also hands the engine RBXEventTrackerV2, the device identity
+// the BrowserTracker bootstrap keeps next to the session cookie. Roblox
+// rejects some requests (blocking a player, for one) from sessions without it.
+std::string BrowserTrackerCookieValue() {
+  std::string text;
+  const std::string env_cookies = GetEnvString("MOCKTAIL_ROBLOX_COOKIES", "");
+  if (!env_cookies.empty()) {
+    text = env_cookies;
+  } else {
+    std::ifstream input(GetEnvString("MOCKTAIL_COOKIE_FILE",
+                                     MocktailCookiePath().c_str()),
+                        std::ios::binary);
+    char buffer[64 * 1024];
+    input.read(buffer, sizeof(buffer));
+    text.assign(buffer, static_cast<std::size_t>(input.gcount()));
+    std::fill(std::begin(buffer), std::end(buffer), '\0');
+  }
+  std::string value;
+  constexpr std::string_view kPrefix = "RBXEventTrackerV2=";
+  const std::size_t pos = text.find(kPrefix);
+  if (pos != std::string::npos &&
+      (pos == 0 || text[pos - 1] == ';' ||
+       std::isspace(static_cast<unsigned char>(text[pos - 1])))) {
+    const std::size_t start = pos + kPrefix.size();
+    const std::size_t end = text.find_first_of(";\r\n\t", start);
+    value = text.substr(start, end == std::string::npos ? std::string::npos
+                                                        : end - start);
+    while (!value.empty() && value.back() == ' ') value.pop_back();
+    const bool printable =
+        std::all_of(value.begin(), value.end(), [](unsigned char ch) {
+          return ch >= 0x20 && ch < 0x7f && ch != ';' && ch != ',';
+        });
+    if (!printable || value.find("browserid=") == std::string::npos) {
+      value.clear();
+    }
+  }
+  mocktail::runtime::SecurelyClearString(&text);
+  return value;
+}
