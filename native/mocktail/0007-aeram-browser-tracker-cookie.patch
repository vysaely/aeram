+// The Android CookieManager also holds RBXEventTrackerV2, the device identity
+// Mocktail's BrowserTracker bootstrap obtains. Roblox rejects some requests
+// (blocking a player, for one) from sessions without it, so the cookie getters
+// hand it to the engine next to the session cookie.
+std::string BrowserTrackerCookieForJava() {
+  std::lock_guard<std::recursive_mutex> lock(g_jni_state_mutex);
+  if (!g_browser_tracker_loaded) {
+    g_browser_tracker_loaded = true;
+    std::string text;
+    const char* env_cookie = std::getenv("MOCKTAIL_ROBLOX_COOKIES");
+    const char* cookie_file = std::getenv("MOCKTAIL_COOKIE_FILE");
+    if (env_cookie && env_cookie[0] != '\0') {
+      text = env_cookie;
+    } else if (cookie_file && cookie_file[0] != '\0') {
+      text = ReadTextFile(cookie_file);
+    } else {
+      text = ReadTextFile(MocktailConfigRoot() + "/cookie");
+    }
+    constexpr const char* kTrackerPrefix = "RBXEventTrackerV2=";
+    const std::size_t pos = text.find(kTrackerPrefix);
+    if (pos != std::string::npos &&
+        (pos == 0 || text[pos - 1] == ';' ||
+         std::isspace(static_cast<unsigned char>(text[pos - 1])))) {
+      std::string value = CookieValueAfterEquals(text, pos);
+      const bool printable = std::all_of(
+          value.begin(), value.end(), [](unsigned char ch) {
+            return ch >= 0x20 && ch < 0x7f && ch != ';' && ch != ',';
+          });
+      if (printable && value.find("browserid=") != std::string::npos) {
+        g_browser_tracker_cookie = std::move(value);
+      }
+    }
+    ClearCookieString(&text);
+  }
+  return g_browser_tracker_cookie;
+}
+
+std::string CookieHeaderWithTrackerForJava() {
+  std::string header = CookieHeaderForJava();
+  const std::string tracker = BrowserTrackerCookieForJava();
+  if (!header.empty() && !tracker.empty()) {
+    header.append("; RBXEventTrackerV2=").append(tracker);
+  }
+  return header;
+}
